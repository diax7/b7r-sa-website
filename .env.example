# The environment holds what is technical: origins, the database, the storage, the API keys
# and the runtime switches (ADR-052). Everything a person at B7R changes lives in the admin:
# the WhatsApp number, the contact address, the booking link, the analytics ids, the search
# engine verification tokens, the menus, the numbers. Copy to .env.local for development.

# ---- Origins -------------------------------------------------------------------------------
# Production canonical origin. Anything other than https://b7r.sa makes every page noindex
# and robots.txt Disallow: / (protects previews). Leave unset locally and on a rehearsal.
NEXT_PUBLIC_SITE_URL=
# Payload's own origin: https://b7r.sa in production, http://localhost:3004 locally and in CI.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3004
# The merchant app; defaults to https://b7r.app when unset.
NEXT_PUBLIC_APP_URL=

# ---- Database and the admin (BRD 9.2) ------------------------------------------------------
# Postgres; local: docker compose up -d (host port 5435). Needed at build and at runtime.
DATABASE_URL=postgres://b7r:b7r@localhost:5435/b7r
# 32+ random characters (openssl rand -base64 48). Signs admin sessions and encrypts the
# connections' keys: rotating it signs everyone out and makes every stored key unreadable.
PAYLOAD_SECRET=
# One-off: pnpm admin:create on an empty users table (12+ characters, not in a known breach).
# The e2e admin suite signs in with the same pair.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ---- Media (S3-compatible bucket, public read) ---------------------------------------------
# Media goes to the bucket when these are set (production, or local MinIO on :9000), to
# public/media/ otherwise. S3_PUBLIC_URL is the public base of objects when it differs from
# ENDPOINT/BUCKET (a CDN host).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Next's image optimiser refuses media on a private IP (SSRF guard). Set to 1 only when the
# S3 endpoint above is localhost (the compose MinIO, the CI job); never in production.
IMAGES_ALLOW_LOCAL_IP=

# ---- E-mail (Resend: the contact form, the newsletter, the admin's password reset) ---------
RESEND_API_KEY=
# The newsletter audience in Resend.
RESEND_AUDIENCE_ID=
# The sender, on the Resend-verified domain; defaults to «بحر برنت <no-reply@b7r.sa>».
RESEND_FROM=

# ---- Bot gate (Cloudflare Turnstile: the forms and the admin login) ------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Search engines --------------------------------------------------------------------------
# IndexNow: optional; when unset the key is derived from PAYLOAD_SECRET and served at
# /indexnow/{key}.txt. Set it only to keep a key you already registered.
INDEXNOW_KEY=

# ---- Runtime switches ----------------------------------------------------------------------
# Set to "production" ONLY in the production app: asserts the required set at server start
# (docs/RUNBOOK.md). Never in CI, locally or on a rehearsal domain.
B7R_RUNTIME=
# The content engine's kill switch: `false` stops every run whatever the admin says.
AI_CONTENT_ENABLED=

# ---- Tests only (refused in production) ----------------------------------------------------
# `mock` keeps newsletter signups and contact messages in memory; honoured only without a key.
NEWSLETTER_TRANSPORT=
CONTACT_TRANSPORT=
# `1` lets the admin pick the mock AI provider (tests, CI, the review server).
AI_CONTENT_MOCK=
