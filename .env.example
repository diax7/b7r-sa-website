# ---- Public (reaches the browser) ---------------------------------------------------------
# Production canonical origin. Anything other than https://b7r.sa makes every page noindex
# and robots.txt Disallow: / (protects previews). Leave unset locally.
NEXT_PUBLIC_SITE_URL=
# The app merchants register on.
NEXT_PUBLIC_APP_URL=https://b7r.app
# WhatsApp number in international format without "+".
NEXT_PUBLIC_WHATSAPP=966501699572

# ---- Analytics (BRD 6.16) ------------------------------------------------------------------
# GA4 measurement id. The consent bar and GA load only when this is set.
NEXT_PUBLIC_GA_ID=
# Umami script URL and website id; the script loads only when both are set.
# For local previews and CI use the recording stand-in: /umami-test.js and any id.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_ID=

# ---- Newsletter (BRD 6.14, server only) ----------------------------------------------------
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# Test-only: `mock` keeps subscriptions in memory. Honoured only while RESEND_API_KEY is unset.
NEWSLETTER_TRANSPORT=
# In-memory contact transport for tests; refused in production.
CONTACT_TRANSPORT=

# ---- Forms, email, SEO (Phase 1c) ----------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_FROM=
CONTACT_TO=contact@b7r.sa
BOOKING_URL=
INDEXNOW_KEY=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Set to "production" ONLY in the CranL production app: asserts the required set at server
# start (docs/RUNBOOK.md). Never in CI or previews.
B7R_RUNTIME=

# ---- CMS (Phase 2a, BRD 9.2, server only) --------------------------------------------------
# Postgres; local: docker compose up -d (host port 5435). Needed at build and at runtime.
DATABASE_URL=postgres://b7r:b7r@localhost:5435/b7r
# 32+ random characters (openssl rand -base64 48). Signs admin sessions.
PAYLOAD_SECRET=
# Payload's own origin: https://b7r.sa in production, http://localhost:3004 locally and in CI.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3004
# Media on S3 when the bucket and endpoint are set (production, or local MinIO on :9000);
# uploads go to public/media/ otherwise. S3_PUBLIC_URL is the public base of objects when it
# differs from ENDPOINT/BUCKET (a CDN host).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# One-off: pnpm admin:create on an empty users table (12+ characters, not in a known breach).
# The e2e admin suite signs in with the same pair.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
