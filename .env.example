# ---- Public (reaches the browser) ---------------------------------------------------------
# Production canonical origin. Anything other than https://b7r.sa makes every page noindex
# and robots.txt Disallow: / (protects previews). Leave unset locally.
NEXT_PUBLIC_SITE_URL=
# The app merchants register on.
NEXT_PUBLIC_APP_URL=https://b7r.app
# WhatsApp number in international format without "+".
NEXT_PUBLIC_WHATSAPP=966501699572

# ---- Analytics (BRD 6.16) ------------------------------------------------------------------
# GA4 measurement id. The consent bar and GA load only when this is set.
NEXT_PUBLIC_GA_ID=
# Umami script URL and website id; the script loads only when both are set.
# For local previews and CI use the recording stand-in: /umami-test.js and any id.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_ID=

# ---- Newsletter (BRD 6.14, server only) ----------------------------------------------------
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# Test-only: `mock` keeps subscriptions in memory. Honoured only while RESEND_API_KEY is unset.
NEWSLETTER_TRANSPORT=

# ---- Phase 1c (forms, email, SEO) — not read yet -------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_FROM=
CONTACT_TO=contact@b7r.sa
BOOKING_URL=
INDEXNOW_KEY=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
