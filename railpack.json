{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "build": {
      "commands": [
        "bash scripts/ci/migrate.sh",
        "pnpm exec tsx scripts/media-renditions.ts",
        "pnpm run build",
        "node scripts/standalone-assets.mjs"
      ]
    }
  },
  "deploy": {
    "startCommand": "node scripts/start.mjs"
  }
}
